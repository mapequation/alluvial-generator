{
  "name": "alluvial-monorepo",
  "version": "1.16.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter alluvial-app dev",
    "build:lib": "pnpm --filter @mapequation/alluvial-diagram build",
    "build:app": "pnpm --filter alluvial-app build",
    "build": "pnpm build:lib && pnpm build:app",
    "preview": "pnpm --filter alluvial-app preview",
    "test": "pnpm --filter @mapequation/alluvial-diagram test && pnpm --filter alluvial-app test",
    "test:watch": "pnpm --filter alluvial-app test:watch",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
